# ============================================================
# Salin file ini menjadi .env.production lalu isi nilainya.
#   cp .env.production.example .env.production
# JANGAN commit .env.production.
# ============================================================

# FQDN yang mengarah ke IP server (A record). Caddy akan menerbitkan
# sertifikat Let's Encrypt otomatis. Tanpa domain, isi: DOMAIN=:80
DOMAIN=codeit.id

# --- PostgreSQL (container "db") ---
# Gunakan password kuat, sebaiknya hanya huruf/angka agar aman di URL DSN.
POSTGRES_USER=crm
POSTGRES_PASSWORD=ganti-password-ini

# --- Backend Go ---
API_PORT=3001
# Kosongkan saja; MASTER_DSN dirakit otomatis oleh docker-compose.yml
# MASTER_DSN=

# Generate dengan: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Wajib 64 karakter hex (32 byte) untuk AES-256-GCM:
#   openssl rand -hex 32
TENANT_CRED_KEY=

# Origin yang diizinkan (samakan dengan https://$DOMAIN).
CORS_ORIGINS=https://codeit.id

# Opsional, boleh kosong.
REDIS_URL=
