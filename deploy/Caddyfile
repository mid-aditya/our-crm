# Caddy: static frontend + reverse proxy backend + HTTPS otomatis.
# DOMAIN diambil dari environment (lihat .env.production).
# Untuk akses tanpa domain (IP saja), set DOMAIN=:80.

{$DOMAIN} {
	encode zstd gzip

	# API dan WebSocket livechat.
	@backend path /api/* /ws/*
	handle @backend {
		route {
			# Backdoor login demo dimatikan di produksi.
			# Kalau memang butuh mode demo, hapus/komentari dua baris di bawah.
			@demologin path /api/v1/auth/demo-login
			respond @demologin "Not Found" 404

			reverse_proxy backend:3001 {
				# Jangan buffer response: SSE (/api/v1/livechat/sse) butuh streaming.
				flush_interval -1
			}
		}
	}

	# Frontend SPA (adapter-static, fallback index.html).
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
