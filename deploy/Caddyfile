# Caddy internal: static frontend + reverse proxy backend.
# Berjalan HTTP di port 80 container, dipublikasikan ke 127.0.0.1:8080.
# TLS/HTTPS ditangani Nginx di host (lihat deploy/nginx-our-crm.conf).
# Kalau Caddy dipakai langsung tanpa Nginx, ganti ":80" menjadi "{$DOMAIN}".

:80 {
	encode zstd gzip

	# API dan WebSocket livechat.
	@backend path /api/* /ws/*
	handle @backend {
		route {
			# Backdoor login demo dimatikan di produksi.
			# Kalau memang butuh mode demo, hapus/komentari dua baris di bawah.
			@demologin path /api/v1/auth/demo-login
			respond @demologin "Not Found" 404

			reverse_proxy backend:3001 {
				# Jangan buffer response: SSE (/api/v1/livechat/sse) butuh streaming.
				flush_interval -1
			}
		}
	}

	# Frontend SPA (adapter-static, fallback index.html).
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
